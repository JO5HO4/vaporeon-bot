[Unit]
Description=Vaporeon Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/vaporeon-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/vaporeon-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
